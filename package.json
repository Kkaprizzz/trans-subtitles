{
  "name": "trans-subtitles",
  "productName": "Trans Subtitles",
  "version": "0.1.0",
  "description": "Локальная транскрибация речи и рендер оверлея субтитров с альфа-каналом",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "start": "node scripts/run.mjs dev",
    "dev": "node scripts/run.mjs dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test \"src/**/*.test.mjs\"",
    "dist": "electron-vite build && electron-builder",
    "pack": "electron-vite build && electron-builder --dir"
  },
  "devDependencies": {
    "@fontsource-variable/commissioner": "^5.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource/arsenal": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/prata": "^5.3.0",
    "@fontsource/spectral": "^5.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
